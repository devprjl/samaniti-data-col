generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Municipality {
  id             String               @id @default(uuid())
  code           String               @unique
  nameNe         String               @map("name_ne")
  nameEn         String               @map("name_en")
  province       String
  district       String
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  profile        MunicipalityProfile?
  policyEntities PolicyEntity[]
  scraperRuns    ScraperRun[]

  @@map("municipalities")
}

model MunicipalityProfile {
  id             String       @id @default(uuid())
  establishedBs  String?      @map("established_bs")
  totalWards     Int?         @map("total_wards")
  population     Int?
  areaSqKm       Float?       @map("area_sq_km")
  includedVdcsNe String?      @map("included_vdcs_ne")
  email          String?
  website        String?
  facebookPage   String?      @map("facebook_page")
  mobileNo       String?      @map("mobile_no")
  twitterHandle  String?      @map("twitter_handle")
  totalSchools   Int?         @map("total_schools")
  municipalityId String       @unique @map("municipality_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@map("municipality_profiles")
}

model PolicyEntity {
  id             String       @id @default(uuid())
  municipalityId String       @map("municipality_id")
  category       String       // 'notice', 'project', 'report', etc.
  titleNe        String       @map("title_ne")
  titleEn        String?      @map("title_en")
  contentNe      String?      @map("content_ne")
  contentEn      String?      @map("content_en")
  type           String?
  fiscalYear     String?      @map("fiscal_year")
  budgetAmount   Decimal?     @map("budget_amount")
  status         String?
  wardNo         Int?         @map("ward_no")
  publishedDate  String?      @map("published_date")
  sourceUrl      String       @unique @map("source_url")
  metadata       Json?        @map("metadata")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  documents      Document[]
  municipality   Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  @@map("policy_entities")
}

model ScraperRun {
  id             String       @id @default(uuid())
  municipalityId String?      @map("municipality_id")
  scraperName    String       @map("scraper_name")
  status         String       // 'success', 'failed'
  itemsAdded     Int          @default(0) @map("items_added")
  itemsUpdated   Int          @default(0) @map("items_updated")
  durationMs     Int          @map("duration_ms")
  error          String?
  startedAt      DateTime     @default(now()) @map("started_at")
  endedAt        DateTime?    @map("ended_at")
  municipality   Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)

  @@map("scraper_runs")
}

model Document {
  id             String        @id @default(uuid())
  fileName       String        @map("file_name")
  fileType       String?       @map("file_type")
  originalUrl    String        @unique @map("original_url")
  storagePath    String?       @map("storage_path")
  policyEntityId String?       @map("policy_entity_id")
  ocrData        String?       @map("ocr_data")
  createdAt      DateTime      @default(now()) @map("created_at")
  downloadError  String?       @map("download_error")
  downloadStatus String        @default("pending") @map("download_status")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  policyEntity   PolicyEntity? @relation(fields: [policyEntityId], references: [id], onDelete: Cascade)

  @@map("documents")
}
