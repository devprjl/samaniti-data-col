DATABASE_URL='postgres://<username>:<password>@<host>:<port>/samanitidb?schema=public'

# Walk past the first listing page of paginated portals (true / false).
SCRAPER_PAGINATION=false

# ---------------------------------------------------------------------------
# Scraping from the browser
# ---------------------------------------------------------------------------
# The API can start crawlers against live government portals, so the workspace is
# strictly opt-in: only an explicit true mounts it. A deployment that sets nothing
# is read-only, which is the state every hosted copy should be in.
#
# Set this to true to run scrapers from the workspace on your own machine. Do not
# set it on a public deployment.
#
# Read by the backend, which loads THIS file (dotenv.config in
# src/web/backend/index.js). The frontend has its own build-time copy in
# src/web/frontend/.env.production, which hides the workspace navigation in any
# vite build.
#
#   unset / false  workspace refused
#   true           workspace available
SCRAPER_WORKSPACE_ENABLED=true
