DATABASE_URL='postgres://<username>:<password>@<host>:<port>/samanitidb?schema=public'

# Walk past the first listing page of paginated portals (true / false).
SCRAPER_PAGINATION=false

# ---------------------------------------------------------------------------
# Scraping from the browser
# ---------------------------------------------------------------------------
# The API can start crawlers against live government portals, so NODE_ENV=production
# switches the workspace off for good. Nothing can turn it back on in production, not
# even this file: a deployment that happens to ship a .env must not end up publicly
# scrapeable. Collect data by running the scraper locally instead.
#
# These are read by the backend, which loads THIS file (see the dotenv.config call
# in src/web/backend/index.js). The frontend keeps its own build-time copies in
# src/web/frontend/.env.development and .env.production.
#
#   NODE_ENV=development            workspace available (default)
#   NODE_ENV=production             workspace refused, always
#   SCRAPER_WORKSPACE_ENABLED=false workspace refused outside production too
NODE_ENV=development
SCRAPER_WORKSPACE_ENABLED=true
