DATABASE_URL='postgres://<username>:<password>@<host>:<port>/samanitidb?schema=public'

# Walk past the first listing page of paginated portals (true / false). False
# already yields the complete content for portals that do not paginate, so it is
# the default everywhere.
SCRAPER_PAGINATION=false

# ---------------------------------------------------------------------------
# Running scrapers
# ---------------------------------------------------------------------------
# The API can start crawlers against live government portals, so it refuses in
# production and serves the collected records only. There is no variable for
# this: NODE_ENV is the switch, and a deployment sets NODE_ENV=production.
#
# NODE_ENV is not a build-time switch here. It does not change how the portal is
# built and it does not separate a production build from a development one. It
# is a runtime guard on a write operation.
#
# On a local machine NODE_ENV is unset, the workspace is served, and
# `npm run web:backend:dev` exposes it at http://localhost:5001/api/workspace.
# On a deployment it answers 403 with code scraper_workspace_disabled, and the
# workspace page explains itself rather than looking broken.
#
# Do not set NODE_ENV=production locally, or the workspace disappears.
# NODE_ENV=development

# ---------------------------------------------------------------------------
# OCR queue
#
# The scraper does not OCR documents itself. It pushes them onto a Redis list and
# the Python service under services/ocr pops them, converts each document to
# Markdown with docling, and writes the result to documents.ocr_data.
#
# Both sides read these, and both take them from the environment, so they have to
# match. The names here are the defaults in src/core/queue/redis.ts and
# services/ocr/worker.py.
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
OCR_QUEUE_NAME=ocr:jobs
OCR_EVENTS_CHANNEL=ocr:events

# Hand documents to the queue as the ETL writes them. Off by default: turning it
# on means every scrape queues OCR work, and OCR is measured in minutes per page
# on a CPU, so the queue will fall behind the scraper. Prefer running
# `npm run ocr:enqueue` to sweep the backlog deliberately.
ENABLE_AUTO_OCR=false

# Queue the N documents oldest first that still have no OCR text.
# OCR_ENQUEUE_LIMIT=100

# ---------------------------------------------------------------------------
# OCR service (services/ocr)
#
# Only needed when running the service directly rather than as a container. The
# container sets these itself; see Dockerfile.ocr.
# ---------------------------------------------------------------------------

# Run the queue worker inside the Flask process, so one container is the whole
# service. Set to false and run worker.py as its own process to scale out: two
# workers sharing two cores are slower than one, not faster.
RUN_WORKER_IN_PROCESS=true

# Port the Flask API listens on.
PORT=5050

# Where the CLI (main.py) writes .md files. Unused by the worker, which writes
# to the database.
# OCR_OUTPUT_DIR=services/ocr/output

# Model caches. The container mounts a volume at /models and points these there;
# leaving them unset locally puts several GB in the home directory.
# HF_HOME=/models/hf
# DOCLING_CACHE=/models/docling
# TORCH_HOME=/models/torch
# XDG_CACHE_HOME=/models/cache

# Force a device for OCR (cpu / cuda / mps). Unavailable requests fall back to
# auto-detection rather than failing.
# OCR_DEVICE=cpu

# SuryaOCR delegates inference to an external backend. The wheel alone is not
# enough: pick llamacpp (CPU, needs llama-server installed) or a vLLM endpoint.
# SURYA_INFERENCE_BACKEND=llamacpp
# LLAMA_CPP_BINARY=/usr/local/bin/llama-server

# ---------------------------------------------------------------------------
# docker compose
#
# Only read by docker-compose.yml, and only to interpolate the file. The
# required three have no defaults on purpose -- a compose file that silently
# invents a database password will happily start a database nobody can reach.
#
# The published host ports are configurable because 5432 and 6379 collide with
# any Postgres or Redis already running on the machine.
# ---------------------------------------------------------------------------
POSTGRES_USER=<username>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=samanitidb
POSTGRES_PORT=5432
REDIS_PORT=6379
OCR_PORT=5050

# Host ports for the optional scraper/web image (docker compose --profile scraper)
# API_PORT=5001
# WEB_PORT=5173

# docling holds every page of a document in memory as a rendered image, so this
# ceiling matters more than the average would suggest.
# OCR_MEMORY_LIMIT=4g
