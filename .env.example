DATABASE_URL='postgres://<username>:<password>@localhost:5432/samanitidb?schema=public'
REDIS_URL='redis://localhost:6379'
SCRAPER_PAGINATION=false

# The one switch for /api/workspace, which is both the scraper and the OCR workspace
# (src/web/backend/index.js). production refuses both with a 403; development serves
# them. The default in docker-compose.yml is development, so the safest thing is to
# leave this line out entirely rather than set it -- an absent value cannot be left
# pointing the wrong way by a stray process.
#
# Do not set this to production here. The stack runs the crawler and the OCR worker
# on purpose, and it is only on Vercel that production is the correct value.
# NODE_ENV=development

POSTGRES_USER=<username>
POSTGRES_DB=samanitidb
POSTGRES_PASSWORD=<password>

# File downloading & S3 upload toggle (default: false, never enabled on Vercel)
FILE_DOWNLOAD=false

###########################
# staging creds
###########################
AWS_REGION=us-east-1
AWS_ENDPOINT=
AWS_ACCESS_KEY_ID=key_id
AWS_SECRET_ACCESS_KEY=access_key
AWS_BUCKET_NAME=samaniti-be-staging
AWS_FORCE_PATH_STYLE=false
# Optional custom CDN or public domain prefix (e.g. https://cdn.example.com)
S3_PUBLIC_URL_PREFIX=
