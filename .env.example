DATABASE_URL='postgres://<username>:<password>@<host>:<port>/samanitidb?schema=public'

# If running the scrapper locally by downloading the page itself as html

SKIP_FILE_DOWNLOADS=false

# Increase this time if experiencing timeouts when downloading files
FILE_DOWNLOAD_TIMEOUT_MS=60000

# Walk past the first listing page of paginated portals (true / false).
# false (default) collects the first listing page only, which is still the
# complete content for portals that do not paginate. Individual runs started
# from the scraper workspace can override this per route.
SCRAPER_PAGINATION=false
