DATABASE_URL='postgres://<username>:<password>@<host>:<port>/samanitidb?schema=public'
SCRAPER_PAGINATION=false

# Scraping from the browser.
#
# The workspace can start crawlers against live government portals, so it is off
# whenever NODE_ENV=production. A deployment is therefore read-only by default and
# needs no setting here. To let a production deployment run scrapers anyway, set
# SCRAPER_WORKSPACE_ENABLED=true; to switch a local instance off, set it to false.
#
# The deployed frontend hides the workspace navigation with VITE_SCRAPER_WORKSPACE
# (see vercel.json), which is separate from this and only affects the UI.
NODE_ENV=development
SCRAPER_WORKSPACE_ENABLED=false
