{
    "name": "samaniti-data-col",
    "version": "1.0.0",
    "description": "TypeScript web scraping ETL monorepo for public local government portal data in Nepal",
    "type": "module",
    "workspaces": [
        "src/web/backend",
        "src/web/frontend"
    ],
    "scripts": {
        "build": "tsc && npm --workspace=src/web/frontend run build",
        "postinstall": "prisma generate",
        "start": "concurrently \"npm run web:backend:dev\" \"npm run web:frontend:dev\"",
        "dev": "concurrently \"npm run start\" \"npm run ocr:worker\"",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db:reset": "tsx scripts/reset-db.ts",
        "scraper": "tsx runner.ts",
        "web:backend:dev": "npm --workspace=src/web/backend run dev",
        "web:backend:start": "npm --workspace=src/web/backend start",
        "web:backend:bundle": "esbuild src/web/backend/index.js --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist/backend.mjs",
        "web:frontend:dev": "npm --workspace=src/web/frontend run dev",
        "web:frontend:build": "npm --workspace=src/web/frontend run build",
        "vercel-build": "npm run web:backend:bundle && npm run web:frontend:build",
        "verify": "npm run lint && tsc --noEmit",
        "verify:deploy": "node scripts/verify-deployment.mjs",
        "prepare": "husky || true",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "ocr:worker": "cd services/ocr && .venv/bin/python worker.py",
        "ocr:enqueue": "tsx scripts/enqueue-ocr.ts",
        "ocr:pages": "tsx scripts/backfill-page-counts.ts",
        "ocr:sweep": "cd services/ocr && .venv/bin/python sweep.py"
    },
    "lint-staged": {
        "*.{ts,tsx,js,jsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yaml,yml}": [
            "prettier --write"
        ]
    },
    "keywords": [
        "scraping",
        "etl",
        "nepal",
        "local-government",
        "crawlee",
        "prisma"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1147.0",
        "@prisma/adapter-pg": "^7.10.0",
        "@prisma/client": "^7.10.0",
        "cheerio": "1.0.0-rc.12",
        "crawlee": "^3.8.2",
        "dotenv": "^17.4.2",
        "ioredis": "^6.0.0",
        "nepali-date-converter": "^3.4.0",
        "pg": "^8.23.0",
        "playwright": "^1.63.0"
    },
    "devDependencies": {
        "@types/ioredis": "^4.28.10",
        "@types/node": "^20.11.24",
        "@types/pg": "^8.23.1",
        "@typescript-eslint/eslint-plugin": "^8.70.0",
        "@typescript-eslint/parser": "^8.70.0",
        "@vercel/nft": "^1.11.0",
        "ajv": "^8.17.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.10.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "lint-staged": "^17.5.1",
        "prettier": "^3.9.7",
        "prisma": "^7.10.0",
        "ts-node": "^10.9.2",
        "tsx": "^4.23.13",
        "typescript": "^5.3.3"
    }
}
