# Production builds. Read-only portal: the scraper workspace navigation is
# removed and /workspace routes resolve to not-found.
#
# Vite loads this file for `vite build`, which is what Vercel runs, so a
# deployment is read-only without any dashboard configuration. The backend refuses
# the run routes in production regardless of what the frontend shows.
VITE_SCRAPER_WORKSPACE=false

# Where the API lives. Leave unset: the portal and the API are served from the same
# origin on a full-stack deployment, so the current origin is used automatically.
# Set this only when the API is hosted on a different domain, e.g.
# VITE_API_URL=https://api.example.com
