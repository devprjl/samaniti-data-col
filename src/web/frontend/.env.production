# Production builds.
#
# The workspace route is present in every build. Whether a scrape can actually be
# started is the backend's decision at request time: production refuses with 403
# and the page explains that rather than looking broken, so there is no build-time
# switch to keep in step with it.

# Where the API lives. Leave unset: the portal and the API are served from the same
# origin on a full-stack deployment, so the current origin is used automatically.
# Set this only when the API is hosted on a different domain, e.g.
# VITE_API_URL=https://api.example.com
