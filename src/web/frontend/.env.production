# Production builds.
#
# The workspace route is present so the feature is visible and can be opened
# directly, but it cannot execute anything: the backend refuses every workspace
# request on a deployment, and the page explains that rather than looking broken.
# The collected records this portal actually serves are unaffected.
VITE_SCRAPER_WORKSPACE=true

# Where the API lives. Leave unset: the portal and the API are served from the same
# origin on a full-stack deployment, so the current origin is used automatically.
# Set this only when the API is hosted on a different domain, e.g.
# VITE_API_URL=https://api.example.com
