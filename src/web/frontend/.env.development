# Local development. The scraper workspace is available, and the API is the
# backend on your machine.
#
# Vite only loads this file for `npm run web:frontend:dev`. Production builds read
# .env.production instead, so the workspace is hidden there without anyone having
# to remember to set a variable.
VITE_SCRAPER_WORKSPACE=true
VITE_API_URL=http://localhost:5001
