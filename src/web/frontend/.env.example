# Build-time settings for the portal. Vite only exposes variables prefixed with
# VITE_, and only to the browser bundle. Copy this file to `.env.local` to change a
# value for your machine without touching the tracked defaults.
#
# There is deliberately only one. Whether a scrape can be started is decided by the
# backend at request time, not baked into the build, so the portal is identical in
# every build and the two can never disagree about it.

# Base URL of the backend API.
VITE_API_URL=http://localhost:5001
