# Build-time settings for the portal. Vite only exposes variables prefixed with
# VITE_, and only to the browser bundle. Copy this file to `.env.local` to change
# a value for your machine without touching the tracked defaults.
#
# The two modes already have tracked defaults, so you rarely need this:
#   .env.development  -> the scraper workspace is shown, API on localhost
#   .env.production   -> the scraper workspace is hidden, read-only

# Show the scraper workspace navigation and allow /workspace routes.
VITE_SCRAPER_WORKSPACE=true

# Base URL of the backend API.
VITE_API_URL=http://localhost:5001
